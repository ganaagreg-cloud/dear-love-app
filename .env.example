# ═══════════════════════════════════════════════════════════════
#  Dear Love — тохиргоо.  Хуулаад .env.local болгоно:  cp .env.example .env.local
#  Supabase-ийн мөрүүдийг # -тэй үлдээвэл ТУРШИЛТЫН ГОРИМ (demo) ажиллана:
#  нэвтрэх товч, туршилтын QPay, локал файлын сан — ямар ч бүртгэлгүйгээр бүхнийг туршина.
# ═══════════════════════════════════════════════════════════════

# ── Сайт ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # production: https://dearlove.mn
# Бэлгийн линк:  dearlove.mn/p/anu-bat   (production ингэж ажиллана).
# NEXT_PUBLIC_ROOT_DOMAIN-ийг production дээр БИТГИЙ тохируул: тохируулбал бүх линк anu-bat.dearlove.mn
# болно, гэтэл *.dearlove.mn wildcard DNS тохируулаагүй тул линк бүр нээгдэхгүй.
# Зөвхөн локал дээр дэд домэйн туршихад:  NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000  (anu-bat.localhost:3000)
# NEXT_PUBLIC_ROOT_DOMAIN=

# ── Supabase (Project Settings → API) ─────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...        # зөвхөн сервер — хэзээ ч ил гаргахгүй

# ── Wire / QPay (app.wire.mn → API keys, Webhooks) ────
# Хоосон бол туршилтын QPay хуудас гарна (зөвхөн dev/demo).
# WIRE_API_KEY=sk_test_...
# WIRE_WEBHOOK_SECRET=whsec_...
WIRE_ALLOWED_OPERATORS=sandbox           # live дээр Wire-ийн өгсөн operator id, ж: qpay

# ── Холбоо барих (footer, нөхцөл/нууцлал/буцаалтын хуудас, төлбөрийн хуудсанд харагдана) ──
# NEXT_PUBLIC_CONTACT_EMAIL=hello@dearlove.mn
# NEXT_PUBLIC_CONTACT_PHONE=9911 2233
# NEXT_PUBLIC_CONTACT_FACEBOOK=https://m.me/dearlove.mn

# ── Meta (Facebook) Pixel — зарын үр дүнг хэмжинэ (PageView, ViewContent, InitiateCheckout, Purchase) ──
# Events Manager → Data sources → Pixel ID.  Хоосон бол pixel огт ачаалагдахгүй.
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# ── Бусад ────────────────────────────────────────────
# DEMO_MODE=1            # production build дээр туршилтын горимыг хүчээр асаах (жинхэнэ сайтад БИТГИЙ)
# ALLOW_MOCK_PAYMENTS=0  # жинхэнэ сайтад үргэлж 0
#
# Production-д гаргахаас өмнө:  npm run preflight   (production-ий env-ээр — ж: vercel env pull .env.production.local)
